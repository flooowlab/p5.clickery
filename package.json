{
  "name": "p5.clickery",
  "version": "0.1.0",
  "description": "Point-and-click adventure library built on p5.js 2.x: rooms, hotspots, walking, inventory, cutscenes, dialogue (Markdown, Twine, Ink), save/load and a level editor",
  "keywords": [
    "p5js",
    "p5.js",
    "adventure",
    "point-and-click",
    "game",
    "ink",
    "twine"
  ],
  "license": "MIT",
  "author": "Daniele Savasta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flooowlab/p5.clickery.git"
  },
  "bugs": "https://github.com/flooowlab/p5.clickery/issues",
  "homepage": "https://github.com/flooowlab/p5.clickery#readme",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/p5.clickery.min.js",
  "jsdelivr": "dist/p5.clickery.min.js",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "docs",
    "examples",
    "!examples/assets",
    "tools/editor",
    "tools/compile-ink.mjs",
    "tools/lib",
    "tools/shared",
    "tools/find-keys.mjs",
    "tools/check-rooms.mjs",
    "tools/animation",
    "tools/dialogue",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "pretest": "node tools/build.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "prepublishOnly": "npm test",
    "prepare": "node tools/setup-git-hooks.mjs",
    "build:site": "node tools/build.mjs && node tools/build-site.mjs"
  },
  "peerDependencies": {
    "p5": ">=2.0.0 <3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "inkjs": "^2.4.0",
    "jsdoc": "^4.0.5",
    "marked": "^18.1.1",
    "p5": "2.3.4"
  }
}
